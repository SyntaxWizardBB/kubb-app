# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Supabase local-dev artefacts (CLI-managed)
/supabase/.branches/
/supabase/.temp/
/tools/supabase-local/.env
# Any local env file — these hold access tokens, db passwords and service keys
.env
.env.*
!.env.example
/tools/supabase-local/data/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.h
**/ios/Runner/GeneratedPluginRegistrant.m
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Build artifacts in any sub-package (e.g. packages/kubb_domain/build/)
**/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Release signing — a keystore or its passwords must never land in the repo
android/key.properties
*.jks
*.keystore

# Firebase service-account keys (App Distribution publishing credential)
**/service-account*.json
**/*firebase-adminsdk*.json

# Local-only project memory and AI tool configs (per ~/Workbench/CLAUDE.md)
/CLAUDE.md
.claude/
.cursor/
.copilot/

# Third-party rule documents (copyright respective associations)
/docs/rules/*.pdf

# Golden-test diff output (regenerated on every failing run, never a source)
**/test/**/failures/

# Coverage reports
/coverage/

